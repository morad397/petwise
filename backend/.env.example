# Copy this file to ".env" and fill in your own values.
# ".env" is ignored by git, so your connection string never reaches GitHub.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers -> Python).
# The same database is used locally and by the online server.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=petwise

# Secret used to sign login tokens (JWT). Use any long random string.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Frontend address(es) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,https://morad397.github.io

# The first admin account is created automatically from these values when the server starts.
ADMIN_EMAIL=admin@petwise.com
ADMIN_PASSWORD=change_me_admin
ADMIN_NAME=PetWise Admin
